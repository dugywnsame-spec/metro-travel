rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 랭킹 기록: 누구나 볼 수 있고, 본인 것만 고칠 수 있어
    match /scores/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 10
        && (!('bestTpm' in request.resource.data) || (request.resource.data.bestTpm is int && request.resource.data.bestTpm <= 1500))
        && (!('wins' in request.resource.data) || request.resource.data.wins is int)
        && (!('races' in request.resource.data) || request.resource.data.races is int);
    }

    // 서버 시계 맞추기용
    match /clock/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 레이스 방: 로그인한 사람만, 방 설정은 방장만 바꿀 수 있어
    match /rooms/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.host == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.host == request.auth.uid;

      match /players/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
